@@ -22,3 +22,12 @@ Notes:
 - Use GitHub Desktop for pull/push (its network works). PowerShell git could
   not reach github.com on 18 Nov.
 - Do NOT commit the .vs files Visual Studio shows. They are now ignored.
+
+## Midterm → Final switch (do this when midterm is fully over)
+- [ ] Take a **Snapshot** first (Setup → Health check card).
+- [ ] Setup → card 3 → set **Reporting period** to **Final** → Save term and people.
+- [ ] As yourself (Glen, you teach classes): open **My classes**. The "Carry your classes over" card lists your midterm classes, all ticked. Click **Copy selected classes to Final**. Classes appear with blank marks, "Not started".
+- [ ] Check your **Midterm** marks are untouched: switch the period back to Midterm (Setup → card 3), open a class, see the marks. Switch back to Final again.
+- [ ] **View as** a teacher who has classes (e.g. Gregg): the carry-over card shows for them too. In preview a copy click is blocked and saves nothing.
+- [ ] Tell staff: "Open the portal, open My classes, click Copy my classes once. Then enter final marks."
+- [ ] Same flow in spring: period Midterm + semester Spring offers to copy from Fall Final. Fall Midterm (new school year) starts with no copy — classes are added fresh.
diff --git a/app.js b/app.js
index 98991a8..e4ad4fa 100644
--- a/app.js
+++ b/app.js
@@ -16,6 +16,7 @@ const S = {
   me: "", meName: "", siteId: "", siteUrl: "", lists: {},
   students: [], subjects: [], catalogue: [], settingsItem: null, settings: {},
   marks: {}, comments: [], awards: [],
+  carry: null, carryFor: "", carryDone: new Set(), carryShown: [],   // carry-over classes from the previous period (My classes)
   tab: "classes", cls: null, back: "classes",
   advGrade: "", ptcStudent: "", awGrade: "", awForm: {}, awSel: new Set(), awSearch: "", awAll: false,
   loadErr: null,
@@ -35,6 +36,14 @@ const termP = () => ({ ...term(), Period: P().period });
 const inPeriod = (f) => inTerm(f) && (f.Period || "Final") === P().period;
 const isMidterm = () => P().period === "Midterm";
 const termLabel = () => `${P().semester} ${P().academicYear} · ${P().period}`;
+// Where classes can be carried forward from: Final ← Midterm of the same semester;
+// Spring Midterm ← Fall Final of the same school year. Fall Midterm starts fresh (new school year).
+const sourcePeriod = () => {
+  const p = P();
+  if (p.period === "Final") return { Semester: p.semester, AcademicYear: p.academicYear, Period: "Midterm" };
+  if (p.period === "Midterm" && p.semester === "Spring") return { Semester: "Fall", AcademicYear: p.academicYear, Period: "Final" };
+  return null;
+};
 const marksListName = (g) => L.marksPrefix + g;
 const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
 // SheetJS is large; fetch it only when a screen needs spreadsheets (retries once, for patchy connections).
@@ -173,6 +182,20 @@ async function loadMarks(grade) {
 const allMarks = () => Object.values(S.marks).flat();
 const roundScore = (v) => { if (blank(v)) return v; const k = 10 ** (P().scoreDecimals ?? 0); return Math.round(Number(v) * k) / k; };
 const classGradeOf = (r) => r.f.ClassGrade || r.list;
+// Carry-over: the teacher's own rows from the source period. Teachers can only read and edit
+// their own rows, so the teacher must make the copy — rows an admin created would belong to the admin.
+async function loadCarry() {
+  const src = sourcePeriod();
+  S.carry = [];
+  if (!src) return;
+  const gs = P().grades.filter((g) => S.lists[marksListName(g)]);
+  const rows = (await Promise.all(gs.map(async (g) => (await readList(marksListName(g))).map((x) => ({ ...x, list: g }))))).flat();
+  S.carry = rows.filter((r) => r.by === S.me && r.f.Semester === src.Semester && r.f.AcademicYear === src.AcademicYear && (r.f.Period || "Final") === src.Period);
+}
+const carryClassesList = () => {
+  const order = (g) => P().grades.indexOf(g);
+  return groupClasses(S.carry || []).sort((a, b) => order(a.grade) - order(b.grade) || a.subject.localeCompare(b.subject));
+};
 // Student photos: one Graph call lists the library with ready-made thumbnail links (no file downloads).
 async function loadPhotos() {
   S.photos = {};
@@ -358,6 +381,14 @@ function viewClasses(main) {
   const order = (g) => P().grades.indexOf(g);
   const mine = groupClasses(allMarks().filter((r) => r.by === S.me)).sort((a, b) => order(a.grade) - order(b.grade) || a.subject.localeCompare(b.subject));
   const hasLists = P().grades.some((g) => S.lists[marksListName(g)]);
+  // A new period starts empty: offer to carry last period's classes over, once per period.
+  const src = sourcePeriod();
+  const carryKey = src ? `${src.AcademicYear}|${src.Semester}|${src.Period}` : "";
+  if (src && hasLists && S.carryFor !== carryKey) {
+    S.carryFor = carryKey; S.carry = null; S.carryDone = new Set();
+    loadCarry().then(render).catch(() => { S.carry = []; render(); });
+  }
+  const carryHtml = src ? carryCard(src, mine) : "";
   main.innerHTML = `
     <h1>My classes</h1>
     <p class="lede"><span class="badge info">${esc(termLabel())}</span> Each class is one grade and one subject you teach.${isMidterm() ? " Mid-term marks go to your grade advisors for the parent-teacher conferences." : ""}</p>
@@ -372,11 +403,60 @@ function viewClasses(main) {
         </button>`).join("")}
       ${hasLists ? `<button class="class-card" id="addClass" style="border-style:dashed;text-align:center"><div class="t">+ Add a class</div><div class="small muted">Pick a grade and subject</div></button>` : ""}
     </div>
-    ${mine.length === 0 && hasLists ? `<p class="muted small" style="margin-top:14px">You haven't added any classes this semester yet.</p>` : ""}`;
+    ${carryHtml}${mine.length === 0 && hasLists && !carryHtml ? `<p class="muted small" style="margin-top:14px">You haven't added any classes this semester yet.</p>` : ""}`;
   $$(".class-card[data-i]").forEach((b) => (b.onclick = () => { const c = mine[+b.dataset.i]; openClass(c.grade, c.subject, c.level, c.by, "classes"); }));
   const add = $("#addClass"); if (add) add.onclick = () => go("newclass");
+  const carryBtn = $("#carryGo"); if (carryBtn) carryBtn.onclick = () => doCarry(carryBtn);
   const ts = $("#toSetup"); if (ts) ts.onclick = (e) => { e.preventDefault(); go("setup"); };
 }
+const classKeyOf = (c) => [c.grade, c.subject, c.level || "", c.by].join("|");
+// Source-period classes not yet in this period and not copied earlier this session.
+const carryRemaining = (mine) => {
+  const have = new Set(mine.map(classKeyOf));
+  for (const k of S.carryDone || []) have.add(k);
+  return carryClassesList().filter((c) => !have.has(classKeyOf(c)));
+};
+// The carry-over card on My classes: last period's classes, all ticked, one click to copy.
+function carryCard(src, mine) {
+  const label = `${src.Period} (${src.Semester} ${src.AcademicYear})`;
+  if (!S.carry) return mine.length ? "" : notice("", `Looking for your classes from ${esc(label)}…`);
+  const classes = carryRemaining(mine);
+  S.carryShown = classes;
+  if (!classes.length) return "";
+  return `<div class="card" style="border:2px solid var(--accent)"><h3>Carry your classes over</h3>
+    <p class="small">You have ${classes.length} ${classes.length > 1 ? "classes" : "class"} from ${esc(label)} ${mine.length ? "that you have not copied yet" : ""}. Untick any you no longer teach, then copy. Every student comes over with a blank mark row — no re-adding students. Your ${esc(src.Period.toLowerCase())} marks stay saved and unchanged.</p>
+    <div class="grid">${classes.map((c, i) => `<label class="stu-pick"><input type="checkbox" class="carryCls" value="${i}" checked><span><b>${esc(c.grade)} · ${esc(subjectDisplay({ Subject: c.subject, ClassLevel: c.level }))}</b><span class="muted small" style="display:block">${c.total} students</span></span></label>`).join("")}</div>
+    <p style="margin-top:10px"><button class="btn primary" id="carryGo">Copy selected classes to ${esc(P().period)}</button></p></div>`;
+}
+// Copy the ticked classes into the current period: one blank row per student, owned by the teacher.
+async function doCarry(btn) {
+  const picked = $$(".carryCls").filter((c) => c.checked).map((c) => +c.value);
+  const classes = picked.map((i) => (S.carryShown || [])[i]).filter(Boolean);
+  if (!classes.length) return;
+  btn.disabled = true; btn.textContent = "Copying…";
+  try {
+    const existing = new Set(allMarks().filter((r) => r.by === S.me).map((r) => [r.f.StudentID, r.f.Subject, r.f.ClassLevel || "", classGradeOf(r)].join("|")));
+    const reqs = [];
+    let gone = 0;
+    for (const r of classes.flatMap((c) => c.rows)) {
+      const st = studentById(r.f.StudentID);
+      if (!st || !S.lists[marksListName(st.f.Grade)]) { gone++; continue; }   // no longer on the roster
+      const key = [r.f.StudentID, r.f.Subject, r.f.ClassLevel || "", r.f.ClassGrade || st.f.Grade].join("|");
+      if (existing.has(key)) continue;   // already has a row this period
+      existing.add(key);
+      reqs.push({ method: "POST", url: itemsUrl(marksListName(st.f.Grade)), body: { fields: {
+        Title: `${r.f.CalledName || r.f.FullName} – ${r.f.Subject}`, StudentID: r.f.StudentID, FullName: r.f.FullName || "", CalledName: r.f.CalledName || "",
+        Subject: r.f.Subject, SubjectType: r.f.SubjectType || "I", ClassLevel: r.f.ClassLevel || null, ClassGrade: r.f.ClassGrade || null,
+        ...termP(), Submitted: false, Concern: false, TeacherName: S.meName } } });
+    }
+    const res = reqs.length ? await batch(reqs) : [];
+    const bad = batchFailures(res);
+    for (const c of classes) S.carryDone.add(classKeyOf(c));   // don't re-offer copied classes this session
+    await loadMarks();
+    render();
+    flash(bad.length ? "warn" : "ok", `Copied ${reqs.length - bad.length} students in ${classes.length} ${classes.length > 1 ? "classes" : "class"} — marks are blank and ready to enter.${gone ? ` Skipped ${gone} ${gone > 1 ? "students who are" : "student who is"} no longer on the roster.` : ""}${bad.length ? ` ${bad.length} rows failed (${bad[0]?.body?.error?.message || "unknown error"}) — click the copy button again to retry those.` : ""}`);
+  } catch (e) { flash("error", e.message); btn.disabled = false; btn.textContent = `Copy selected classes to ${P().period}`; }
+}
 function openClass(grade, subject, level, by, back) { S.cls = { grade, subject, level, by }; S.back = back; go("entry"); }
 
 // Pick bobaes from other grades into a class (e.g. Ryan and Blair, G11, sitting in a G10 class).
@@ -1683,6 +1763,7 @@ function viewSetup(main) {
         <label><span>Academic year</span><input id="sYear" value="${esc(p.academicYear)}"></label>
         <label><span>Semester</span><select id="sSem">${p.semesters.map((s) => `<option ${s === p.semester ? "selected" : ""}>${esc(s)}</option>`).join("")}</select></label>
         <label><span>Reporting period: what teachers are entering now</span><select id="sPeriod">${p.periods.map((s) => `<option ${s === p.period ? "selected" : ""}>${esc(s)}</option>`).join("")}</select></label>
+        <p class="small muted wide" style="margin:0">Switching the period starts a fresh marks round. Teachers do not add their classes again: each teacher opens <b>My classes</b> once and clicks <b>Copy my classes</b>. The other period's marks stay saved and unchanged.</p>
         <label class="wide"><span>Admins (full access in this app), one email per line</span><textarea id="sAdmins" rows="2">${esc(p.admins.join("\n"))}</textarea></label>
         <label class="wide"><span>Leadership (read-only across grades), one email per line. Also add them as Owners of the SharePoint site.</span><textarea id="sLead" rows="3">${esc(p.leadership.join("\n"))}</textarea></label>
         <label class="wide"><span>Admin team: the only people who can generate report cards (the Report cards tab). One email per line; admins are included automatically.</span><textarea id="sReport" rows="3">${esc((p.reportTeam || []).join("\n"))}</textarea></label>
